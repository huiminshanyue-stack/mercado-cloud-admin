page {
  min-height: 100%;
  background: #f3f6fa;
  color: #1f2d3d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after { border: 0; }
.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx; }
.card { background: #fff; border-radius: 20rpx; box-shadow: 0 8rpx 30rpx rgba(31,45,61,.06); }
.primary-button { color: #fff; background: #1677ff; border-radius: 14rpx; font-size: 30rpx; }
.muted { color: #8a97a6; }
.danger { color: #ef5350; }
.success { color: #16a66a; }
