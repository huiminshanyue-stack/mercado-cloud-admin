.orders-page { padding-bottom:50rpx; }
.header { display:flex; justify-content:space-between; align-items:center; margin:4rpx 0 28rpx; }
.title { font-size:42rpx; font-weight:750; }
.subtitle { margin-top:8rpx; color:#8492a1; font-size:24rpx; }
.logout { margin:0; color:#647386; background:#fff; border-radius:12rpx; }
.account-total-card { box-sizing:border-box; margin-bottom:28rpx; padding:28rpx; }
.account-total-head { display:flex; align-items:flex-start; justify-content:space-between; }
.account-total-title,.account-total-subtitle { display:block; }
.account-total-title { color:#1f2d3d; font-size:29rpx; font-weight:700; }
.account-total-subtitle { margin-top:6rpx; color:#929eaa; font-size:20rpx; }
.total-profit-label { margin-top:26rpx; color:#536170; font-size:23rpx; font-weight:600; }
.total-profit-value { margin-top:5rpx; color:#08749d; font-size:52rpx; font-weight:760; letter-spacing:-1rpx; }
.currency-symbol { margin-right:8rpx; font-size:28rpx; font-weight:650; }
.account-total-divider { height:1rpx; margin:23rpx 0 20rpx; background:#edf0f3; }
.account-total-metrics { display:flex; }
.account-total-metrics > view { flex:1; }
.account-metric-label,.account-metric-value { display:block; }
.account-metric-label { color:#5d6975; font-size:22rpx; font-weight:600; }
.account-metric-value { margin-top:8rpx; color:#1f2d3d; font-size:30rpx; font-weight:720; }
.rate-value { color:#e7872b; }
.account-total-basis { margin-top:20rpx; color:#8a96a2; font-size:20rpx; }
.recent-section { margin-bottom:22rpx; }
.recent-title-row { display:flex; align-items:center; justify-content:space-between; margin:0 4rpx 16rpx; }
.recent-title { color:#1f2d3d; font-size:31rpx; font-weight:700; }
.summary-loading { color:#8c98a5; font-size:22rpx; }
.period-tabs { display:flex; padding:7rpx; background:#e7ebf0; border-radius:999rpx; }
.period-tab { flex:1; padding:18rpx 8rpx; color:#687686; font-size:25rpx; text-align:center; border-radius:999rpx; }
.period-tab.active { color:#1e2b38; background:#fff; box-shadow:0 5rpx 16rpx rgba(31,45,61,.14); font-weight:650; }
.stats-card { display:flex; margin-top:16rpx; padding:22rpx 6rpx; background:#fff3f1; border:1rpx solid #ffe5e0; border-radius:18rpx; }
.stat-item { position:relative; min-width:0; flex:1; text-align:center; }
.stat-item + .stat-item::before { position:absolute; top:10rpx; bottom:10rpx; left:0; width:1rpx; background:#f0dcd8; content:''; }
.stat-label,.stat-value,.stat-unit { display:block; }
.stat-label { color:#596674; font-size:22rpx; }
.stat-value { margin-top:8rpx; overflow:hidden; color:#1f2d3d; font-size:29rpx; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.stat-unit { margin-top:3rpx; color:#9a7f7a; font-size:18rpx; }
.profit-value { color:#159866; }.sales-value { color:#d66d49; }
.summary-basis { margin:12rpx 6rpx 0; color:#7b8896; font-size:21rpx; }
.summary-pending { margin:7rpx 6rpx 0; color:#dc7a22; font-size:21rpx; }
.filters { padding:22rpx; }
.search { height:80rpx; padding:0 24rpx; background:#f5f7fa; border-radius:13rpx; font-size:28rpx; }
.filter-row { display:flex; gap:18rpx; margin-top:18rpx; }
.picker { flex:1; padding:20rpx 22rpx; color:#526170; background:#f5f7fa; border-radius:13rpx; font-size:26rpx; }
.summary { padding:24rpx 8rpx 16rpx; color:#7f8c9b; font-size:24rpx; }
.order-card { margin-bottom:22rpx; padding:24rpx; overflow:hidden; }
.order-head { display:flex; align-items:center; gap:14rpx; }
.state { padding:7rpx 14rpx; border-radius:9rpx; font-size:22rpx; background:#eef4ff; color:#1677ff; }
.state-pending { background:#fff5e8; color:#e68a00; }.state-done { background:#eaf8f1; color:#16a66a; }.state-closed { background:#fff0f0; color:#ef5350; }
.country { font-size:26rpx; font-weight:650; }.order-no { flex:1; overflow:hidden; color:#4c5c6c; font-size:25rpx; text-align:right; text-overflow:ellipsis; white-space:nowrap; }
.store-line { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:16rpx 0; }
.store { min-width:0; overflow:hidden; color:#1677ff; font-size:24rpx; text-overflow:ellipsis; white-space:nowrap; }
.product-count { flex:none; color:#7f8c9b; font-size:22rpx; }
.products-list { border-top:1rpx solid #eef1f5; border-bottom:1rpx solid #eef1f5; }
.product { display:flex; gap:20rpx; padding:18rpx 0; }
.product + .product { border-top:1rpx solid #eef1f5; }
.image { width:132rpx; height:132rpx; flex:none; background:#f1f3f6; border-radius:14rpx; }
.product-main { min-width:0; flex:1; }.product-title { display:-webkit-box; overflow:hidden; font-size:28rpx; font-weight:650; line-height:1.45; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.meta { margin-top:10rpx; overflow:hidden; color:#83909f; font-size:23rpx; text-overflow:ellipsis; white-space:nowrap; }
.variant-row { display:flex; align-items:center; gap:16rpx; min-width:0; margin-top:10rpx; color:#83909f; font-size:23rpx; }
.sku-meta { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.color-meta { flex:none; color:#5f6d7a; white-space:nowrap; }
.order-date { padding-top:13rpx; color:#83909f; font-size:23rpx; }
.dispatch-deadline { margin-top:10rpx; padding:10rpx 13rpx; color:#bd6b12; background:#fff6e8; border-radius:9rpx; font-size:22rpx; font-weight:600; }
.money-row { display:flex; justify-content:space-between; align-items:flex-end; padding-top:20rpx; }
.money-row view { display:flex; flex-direction:column; }.money-row view:last-child { text-align:right; }
.label { color:#8b97a4; font-size:22rpx; }.amount { margin-top:5rpx; font-size:29rpx; font-weight:700; }.payout { color:#16a66a; }
.cost-column { align-items:flex-end; }.cost-action { margin:7rpx 0 0; padding:0 14rpx; color:#1677ff; background:#edf5ff; font-size:21rpx; line-height:46rpx; }
.empty,.loading-more { padding:90rpx 0; color:#94a0ad; text-align:center; font-size:26rpx; }.loading-more { padding:28rpx 0; }
