<view class="page orders-page">
  <view class="header">
    <view><view class="title">订单工作台</view><view class="subtitle">{{userName}} · 只读内测</view></view>
    <button class="logout" size="mini" bindtap="logout">退出</button>
  </view>

  <view class="recent-section">
    <view class="recent-title-row"><text class="recent-title">最近订单</text><text wx:if="{{summaryLoading}}" class="summary-loading">更新中</text></view>
    <view class="period-tabs">
      <view wx:for="{{periodTabs}}" wx:for-item="period" wx:key="value" class="period-tab {{summaryPeriod === period.value ? 'active' : ''}}" data-period="{{period.value}}" bindtap="onPeriodChange">{{period.name}}</view>
    </view>
    <view class="stats-card">
      <view class="stat-item"><text class="stat-label">订单数</text><text class="stat-value">{{workbenchSummary.orderCount}}</text><text class="stat-unit">单</text></view>
      <view class="stat-item"><text class="stat-label">利润</text><text class="stat-value profit-value">{{workbenchSummary.profitText}}</text><text class="stat-unit">CNY</text></view>
      <view class="stat-item"><text class="stat-label">销售额</text><text class="stat-value sales-value">{{workbenchSummary.salesText}}</text><text class="stat-unit">CNY</text></view>
      <view class="stat-item"><text class="stat-label">利润率</text><text class="stat-value">{{workbenchSummary.profitRateText}}</text><text class="stat-unit">回款口径</text></view>
    </view>
    <view class="summary-basis">销售额 = 官方应回款 USD × 汇率 {{workbenchSummary.exchangeRateText}}</view>
    <view wx:if="{{workbenchSummary.pendingPayoutCount > 0}}" class="summary-pending">{{workbenchSummary.pendingPayoutCount}} 单官方回款待获取，暂未计入金额与利润率</view>
  </view>

  <view class="card filters">
    <input class="search" placeholder="输入订单号" confirm-type="search" value="{{orderId}}" bindinput="onOrderId" bindconfirm="applyFilters" />
    <view class="filter-row">
      <picker class="picker" mode="selector" range="{{storeNames}}" value="{{storeIndex}}" bindchange="onStoreChange">
        <view>{{storeNames[storeIndex] || '全部店铺'}}⌄</view>
      </picker>
      <picker class="picker" mode="selector" range="{{statusNames}}" value="{{statusIndex}}" bindchange="onStatusChange">
        <view>{{statusNames[statusIndex]}}⌄</view>
      </picker>
    </view>
  </view>

  <view class="summary">共 {{total}} 单 · 下拉刷新最新状态</view>
  <view wx:if="{{loading && !orders.length}}" class="empty">正在读取订单…</view>
  <view wx:elif="{{!loading && !orders.length}}" class="empty">当前筛选条件下暂无订单</view>

  <view wx:for="{{orders}}" wx:key="displayOrderId" class="card order-card" data-id="{{item.displayOrderId}}" bindtap="openOrder">
    <view class="order-head">
      <view class="state state-{{item.stateKey}}">{{item.stateText}}</view>
      <view class="country">{{item.countryFlag}} {{item.countryName}}</view>
      <view class="order-no">{{item.displayOrderId}}</view>
    </view>
    <view class="store-line"><view class="store">{{item.storeName}}</view><view class="product-count">共 {{item.productCount}} 件</view></view>
    <view class="products-list">
      <view wx:for="{{item.products}}" wx:for-item="product" wx:for-index="productIndex" wx:key="productKey" class="product">
        <image class="image" mode="aspectFill" src="{{product.image}}" />
        <view class="product-main">
          <view class="product-title">{{product.title}}</view>
          <view class="meta">数量 ×{{product.quantity}}</view>
          <view class="variant-row"><text class="sku-meta">SKU：{{product.sku}}</text><text class="color-meta">颜色：{{product.color}}</text></view>
        </view>
      </view>
    </view>
    <view class="order-date">下单：{{item.dateText}}</view>
    <view wx:if="{{item.stateKey === 'pending'}}" class="dispatch-deadline">{{item.dispatchDeadlineText}}</view>
    <view class="money-row">
      <view><text class="label">商品金额</text><text class="amount">{{item.grossText}}</text></view>
      <view><text class="label">应回款</text><text class="amount payout">{{item.payoutText}}</text></view>
      <view class="cost-column"><text class="label">成本 CNY {{item.costText}}</text><button class="cost-action" size="mini" data-id="{{item.displayOrderId}}" catchtap="openCost">填写成本</button></view>
    </view>
  </view>
  <view wx:if="{{loading && orders.length}}" class="loading-more">加载中…</view>
  <view wx:if="{{!hasMore && orders.length}}" class="loading-more">已显示全部订单</view>
</view>
