<view class="page detail-page">
  <view wx:if="{{loading}}" class="empty">正在读取订单详情…</view>
  <block wx:elif="{{order}}">
    <view class="card section hero">
      <view class="hero-line"><text class="state">{{order.stateText}}</text><text>{{order.countryFlag}} {{order.countryName}}</text></view>
      <view class="order-no">订单号：{{order.displayOrderId}}</view>
      <view class="muted">{{order.storeName}}　下单：{{order.dateText}}</view>
      <view class="deadline">{{order.deadlineText}}</view>
    </view>

    <view class="card section">
      <view class="section-title">商品信息</view>
      <view wx:for="{{order.products}}" wx:key="itemId" class="product">
        <image class="image" mode="aspectFit" src="{{item.image}}" data-index="{{index}}" bindtap="previewImage" />
        <view class="product-main"><view class="product-title">{{item.title}}</view><view class="muted">商品ID：<text user-select="true">{{item.itemId}}</text></view><view class="muted">SKU：{{item.sku}}　数量 ×{{item.quantity}}</view></view>
      </view>
      <view class="row"><text>买家</text><text user-select="true">{{order.buyer || '-'}}</text></view>
    </view>

    <view wx:if="{{order.status === 'cancelled'}}" class="card section warning-section"><view class="section-title">取消原因</view><view class="explain">{{order.cancellationText}}</view></view>

    <view wx:if="{{order.reputationImpact}}" class="card section reputation-section">
      <view class="section-title">该订单影响店铺声誉</view>
      <view class="explain"><text class="strong-label">原因：</text>{{order.reputationReasonText}}</view>
      <view wx:if="{{order.reputationResponsibility}}" class="explain"><text class="strong-label">责任方：</text>{{order.reputationResponsibility}}</view>
      <view wx:if="{{order.reputationFeedback}}" class="explain"><text class="strong-label">官方反馈：</text>{{order.reputationFeedback}}</view>
      <view wx:if="{{order.reputationAdvice}}" class="explain"><text class="strong-label">处理建议：</text>{{order.reputationAdvice}}</view>
    </view>

    <view class="card section">
      <view class="section-title">官方账单与利润</view>
      <view class="row"><text>商品金额</text><text>{{order.grossText}}</text></view>
      <view class="row"><text>销售佣金</text><text>{{order.saleFeeText}}</text></view>
      <view class="row"><text>物流运输</text><text>{{order.shippingFeeText}}</text></view>
      <view class="row"><text>退款金额</text><text>{{order.refundText}}</text></view>
      <view class="row strong"><text>应回款</text><text class="success">{{order.payoutText}}</text></view>
      <view class="finance-hint">{{order.payoutHint}}，不使用销售额估算。</view>
      <view class="row"><text>商品成本</text><text>CNY {{order.costText}}</text></view>
    </view>

    <view wx:if="{{order.dimensionsAvailable}}" class="card section">
      <view class="section-title">长宽高与重量</view>
      <view class="dimension-label">旧值（下单时申报）</view><view class="dimension-value">{{order.originalDimensionText}}</view>
      <view class="dimension-label">新值（美客多当前计费值）</view><view class="dimension-value">{{order.latestDimensionText}}</view>
      <view wx:if="{{order.dimensionsChanged}}" class="dimension-changed">美客多官方值已变化，是否产生额外运费以官方账单为准。</view>
    </view>

    <view class="card section">
      <view class="section-title">物流信息</view>
      <view class="row"><text>物流方式</text><text>{{order.trackingMethod || '-'}}</text></view>
      <view class="row"><text>国际运单号</text><text user-select="true">{{order.trackingNumber || '-'}}</text></view>
      <view class="row"><text>Shipment ID</text><text user-select="true">{{order.shippingId || '-'}}</text></view>
      <view class="row"><text>24小时上网</text><text>{{order.onlineText}}</text></view>
    </view>
    <view class="readonly">当前为只读内测版，回复消息、修改成本和提交代贴单将在确认权限后逐项开放。</view>
  </block>
</view>
