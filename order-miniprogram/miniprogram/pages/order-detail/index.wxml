<view class="page detail-page">
  <view wx:if="{{loading}}" class="empty">正在读取订单详情…</view>
  <block wx:elif="{{order}}">
    <view class="card section hero">
      <view class="hero-line"><text class="state">{{order.stateText}}</text><text>{{order.countryFlag}} {{order.countryName}}</text></view>
      <view class="order-no">订单号：{{order.displayOrderId}}</view>
      <view class="muted">{{order.storeName}}　下单：{{order.dateText}}</view>
      <view class="deadline">{{order.deadlineText}}</view>
      <button class="sync-order-button" size="mini" loading="{{orderSyncing}}" disabled="{{orderSyncing}}" bindtap="syncOrder">同步订单</button>
    </view>

    <view class="card section">
      <view class="section-title">商品信息</view>
      <view wx:for="{{order.products}}" wx:key="productKey" class="product">
        <image class="image" mode="aspectFit" src="{{item.image}}" data-index="{{index}}" bindtap="previewImage" />
        <view class="product-main"><view class="product-title">{{item.title}}</view><view class="muted">商品ID：<text user-select="true">{{item.itemId}}</text></view><view class="muted">数量 ×{{item.quantity}}</view><view class="variant-row"><text class="sku-meta">SKU：{{item.sku}}</text><text class="color-meta">颜色：{{item.color}}</text></view></view>
      </view>
      <view class="row"><text>买家</text><text user-select="true">{{order.buyer || '-'}}</text></view>
    </view>

    <view wx:if="{{order.status === 'cancelled'}}" class="card section warning-section"><view class="section-title">取消原因</view><view class="explain">{{order.cancellationText}}</view></view>

    <view wx:if="{{order.reputationImpact}}" class="card section reputation-section">
      <view class="section-title">该订单影响店铺声誉</view>
      <view class="explain"><text class="strong-label">原因：</text>{{order.reputationReasonText}}</view>
      <view wx:if="{{order.reputationResponsibility}}" class="explain"><text class="strong-label">责任方：</text>{{order.reputationResponsibility}}</view>
      <view wx:if="{{order.reputationFeedback}}" class="explain"><text class="strong-label">官方反馈：</text>{{order.reputationFeedback}}</view>
      <view wx:if="{{order.reputationAdvice}}" class="explain"><text class="strong-label">处理建议：</text>{{order.reputationAdvice}}</view>
    </view>

    <view class="card section">
      <view class="section-title">官方账单与利润</view>
      <view class="row"><text>商品金额</text><text>{{order.grossText}}</text></view>
      <view class="row"><text>销售佣金</text><text>{{order.saleFeeText}}</text></view>
      <view class="row"><text>物流运输</text><text>{{order.shippingFeeText}}</text></view>
      <view class="row"><text>退款金额</text><text>{{order.refundText}}</text></view>
      <view class="row strong"><text>应回款</text><text class="success">{{order.payoutText}}</text></view>
      <view class="finance-hint">{{order.payoutHint}}，不使用销售额估算。</view>
      <view class="row"><text>整单商品成本</text><text>{{order.costText}}</text></view>
      <view class="row strong"><text>人民币利润</text><text class="{{order.profitClass}}">{{order.profitText}}</text></view>
      <button class="cost-button" bindtap="openCost">查看或修改订单成本</button>
    </view>

    <view class="card section">
      <view class="dimension-heading">
        <view class="section-title dimension-title">长宽高与重量</view>
        <button class="dimension-refresh" size="mini" loading="{{dimensionRefreshing}}" disabled="{{dimensionRefreshing}}" bindtap="refreshDimensions">获取最新尺寸重量</button>
      </view>
      <block wx:if="{{order.dimensionsAvailable}}">
        <view class="dimension-label">卖家自主填写的数值</view>
        <view class="dimension-note">卖家在店铺后台自行填写并随订单上报</view>
        <view class="dimension-value">{{order.sellerDimensionText}}<text wx:if="{{order.sellerWeightHint}}" class="weight-hint {{order.sellerWeightHintClass}}">{{order.sellerWeightHint}}</text></view>
        <view class="dimension-label">美客多平台返回的值</view>
        <view class="dimension-note">{{order.platformDimensionNote}}</view>
        <view class="dimension-value">{{order.platformDimensionText}}<text wx:if="{{order.weightAnomaly}}" class="weight-anomaly">重量异常</text></view>
        <view class="dimension-rule">系统比较两组数据，并以数值较高的一组作为运费计费依据；最终费用以美客多官方账单为准。</view>
      </block>
      <view wx:else class="dimension-empty">尚未获取尺寸重量，点击右上角按钮查询美客多最新数据。</view>
    </view>

    <view class="card section">
      <view class="section-title">物流信息</view>
      <view class="row"><text>物流方式</text><text>{{order.trackingMethod || '-'}}</text></view>
      <view class="row"><text>国际运单号</text><text user-select="true">{{order.trackingNumber || '-'}}</text></view>
      <view class="row"><text>Shipment ID</text><text user-select="true">{{order.shippingId || '-'}}</text></view>
    </view>

    <view wx:if="{{order.fulfillmentSubmission}}" class="card section fulfillment-submitted">
      <view class="section-title">代贴单提交信息</view>
      <view class="row"><text>仓库</text><text>{{order.fulfillmentSubmission.warehouseName || '-'}}</text></view>
      <view class="row"><text>快递公司</text><text>{{order.fulfillmentSubmission.carrier || '-'}}</text></view>
      <view class="row"><text>国内快递单号</text><text user-select="true">{{order.fulfillmentSubmission.trackingNumber || '-'}}</text></view>
      <view class="row"><text>发货数量</text><text>{{order.fulfillmentSubmission.shippingQuantity || order.totalQuantity}}</text></view>
      <view wx:if="{{order.fulfillmentSubmission.shippingRemark}}" class="row"><text>备注</text><text>{{order.fulfillmentSubmission.shippingRemark}}</text></view>
      <view wx:if="{{order.fulfillmentSubmission.status === 'failed'}}" class="fulfillment-error">{{order.fulfillmentSubmission.failureReason || '提交失败，请在订单工作台重新推送'}}</view>
      <button wx:if="{{order.canResubmitFulfillment && !fulfillmentResubmit && !fulfillmentExpressEditing}}" class="fulfillment-resubmit-button" bindtap="startFulfillmentResubmit">{{order.fulfillmentSubmission.status === 'failed' ? '重新提交代贴单' : '重新提交或更换仓库'}}</button>
      <button wx:if="{{order.fulfillmentSubmission.status === 'success' && order.fulfillmentSubmission.provider === 'yeeke' && !fulfillmentExpressEditing}}" class="express-update-button" bindtap="startExpressUpdate">修改国内快递号</button>
      <view wx:if="{{fulfillmentExpressEditing}}" class="express-update-form">
        <view class="form-hint">只修改 Yeeke 原订单的快递记录，不会创建新订单或改变仓库。</view>
        <view class="form-label">快递公司</view>
        <picker mode="selector" range="{{carrierNames}}" value="{{carrierIndex}}" bindchange="onCarrierChange">
          <view class="picker-value">{{carrierNames[carrierIndex] || '请选择快递公司'}}</view>
        </picker>
        <view class="form-label">新国内快递单号</view>
        <input class="form-input" data-field="trackingNumber" value="{{fulfillmentForm.trackingNumber}}" placeholder="请输入正确的国内快递单号" bindinput="onFulfillmentInput" />
        <view class="form-label">备注</view>
        <textarea class="form-textarea" data-field="remark" value="{{fulfillmentForm.remark}}" maxlength="500" placeholder="备注会随新快递记录同步到 Yeeke" bindinput="onFulfillmentInput" />
        <view class="express-update-actions"><button size="mini" bindtap="cancelExpressUpdate">取消</button><button size="mini" type="primary" loading="{{fulfillmentExpressUpdating}}" disabled="{{fulfillmentExpressUpdating}}" bindtap="submitExpressUpdate">同步修改</button></view>
      </view>
    </view>

    <view wx:if="{{(order.canSubmitFulfillment && !order.fulfillmentSubmission) || (fulfillmentResubmit && order.canResubmitFulfillment)}}" class="card section fulfillment-form">
      <view class="section-title">{{fulfillmentResubmit ? '重新提交代贴单' : '提交代贴单'}}</view>
      <view class="form-label">选择仓库</view>
      <picker mode="selector" range="{{warehouseNames}}" value="{{warehouseIndex}}" bindchange="onWarehouseChange">
        <view class="picker-value">{{warehouseNames[warehouseIndex] || '请选择管理员配置的仓库'}}</view>
      </picker>
      <view class="form-label">快递公司</view>
      <picker mode="selector" range="{{carrierNames}}" value="{{carrierIndex}}" bindchange="onCarrierChange">
        <view class="picker-value">{{carrierNames[carrierIndex] || '请选择快递公司'}}</view>
      </picker>
      <view class="form-label">国内快递单号</view>
      <input class="form-input" data-field="trackingNumber" value="{{fulfillmentForm.trackingNumber}}" placeholder="请输入国内快递单号" bindinput="onFulfillmentInput" />
      <view class="form-label">发货数量</view>
      <input class="form-input" type="number" data-field="quantity" value="{{fulfillmentForm.quantity}}" placeholder="1" bindinput="onFulfillmentInput" />
      <view class="form-hint">当前订单最多可填写 {{order.totalQuantity}} 件</view>
      <view class="form-label">备注</view>
      <textarea class="form-textarea" data-field="remark" value="{{fulfillmentForm.remark}}" maxlength="500" placeholder="备注会随国内快递一起推送到仓库" bindinput="onFulfillmentInput" />
      <view class="fulfillment-form-actions"><button wx:if="{{fulfillmentResubmit}}" class="fulfillment-cancel" bindtap="cancelFulfillmentResubmit">取消</button><button class="fulfillment-submit" type="primary" loading="{{fulfillmentSubmitting}}" disabled="{{fulfillmentSubmitting || fulfillmentOptionsLoading}}" bindtap="submitFulfillment">{{fulfillmentResubmit ? '确认重新提交' : '提交代贴单'}}</button></view>
    </view>
    <view wx:if="{{!order.canSubmitFulfillment && !order.fulfillmentSubmission}}" class="readonly">仅待发货订单可以提交代贴单。</view>
  </block>
</view>
