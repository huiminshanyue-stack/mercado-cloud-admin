.section { margin-bottom:22rpx; padding:28rpx; }
.hero { background:linear-gradient(145deg,#1677ff,#4d96ff); color:#fff; }
.hero .muted { color:rgba(255,255,255,.75); }.hero-line { display:flex; justify-content:space-between; align-items:center; }.state { padding:8rpx 16rpx; background:rgba(255,255,255,.18); border-radius:10rpx; }
.order-no { margin:24rpx 0 14rpx; font-size:32rpx; font-weight:700; }
.deadline { margin-top:18rpx; padding-top:16rpx; border-top:1rpx solid rgba(255,255,255,.22); font-size:24rpx; }
.product { display:flex; gap:22rpx; padding:22rpx 0; border-bottom:1rpx solid #f0f2f5; }.image { width:180rpx; height:180rpx; flex:none; background:#f5f6f8; border-radius:14rpx; }.product-main { min-width:0; flex:1; }.product-title { margin-bottom:18rpx; font-size:29rpx; font-weight:650; line-height:1.5; }.product .muted { margin-top:10rpx; font-size:23rpx; }
.variant-row { display:flex; align-items:center; gap:16rpx; min-width:0; margin-top:10rpx; color:#7f8b97; font-size:23rpx; }.sku-meta { min-width:0; flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.color-meta { flex:none; color:#526170; white-space:nowrap; }
.section-title { padding-bottom:18rpx; font-size:31rpx; font-weight:700; border-bottom:1rpx solid #eef1f5; }.row { display:flex; justify-content:space-between; gap:28rpx; padding:17rpx 0; color:#5e6c79; font-size:26rpx; border-bottom:1rpx solid #f1f3f6; }.row text:last-child { text-align:right; }.row.strong { color:#1f2d3d; font-weight:700; }
.warning-section { border-left:7rpx solid #f2a11f; background:#fffaf0; }.reputation-section { border-left:7rpx solid #ef5350; background:#fff7f7; }.explain { padding-top:18rpx; color:#5f6770; font-size:25rpx; line-height:1.65; }.strong-label { color:#303843; font-weight:700; }.finance-hint { padding:16rpx 0 4rpx; color:#8995a2; font-size:22rpx; }.dimension-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; padding-bottom:18rpx; border-bottom:1rpx solid #eef1f5; }.dimension-title { flex:1; padding-bottom:0; border-bottom:0; }.dimension-refresh { flex:none; margin:0; padding:0 18rpx; color:#1677ff; background:#edf5ff; border:0; font-size:22rpx; line-height:2.2; }.dimension-refresh::after { border:0; }.dimension-label { margin-top:22rpx; color:#263442; font-size:25rpx; font-weight:650; }.dimension-note { margin-top:5rpx; color:#8a96a3; font-size:21rpx; line-height:1.5; }.dimension-value { margin-top:9rpx; color:#364554; font-size:25rpx; line-height:1.6; }.weight-hint,.weight-anomaly { display:inline-block; margin-left:10rpx; padding:2rpx 9rpx; border-radius:7rpx; font-size:20rpx; line-height:1.5; vertical-align:2rpx; }.weight-hint { color:#16825d; background:#e9f7f1; }.weight-anomaly { color:#d93025; background:#fdecec; font-weight:700; }.dimension-rule { margin-top:22rpx; padding:16rpx 18rpx; color:#786132; background:#fff8e8; border-radius:10rpx; font-size:22rpx; line-height:1.65; }.dimension-empty { padding:28rpx 0 8rpx; color:#8d99a7; font-size:23rpx; line-height:1.7; }
.cost-button { margin-top:22rpx; color:#1677ff; background:#edf5ff; font-size:25rpx; }
.weight-hint.is-lower { color:#16825d; background:#e9f7f1; }
.weight-hint.is-higher { color:#b26a00; background:#fdf1dc; }
.weight-hint.is-equal { color:#606266; background:#f2f3f5; }
.readonly { padding:18rpx 20rpx 50rpx; color:#8d99a7; font-size:23rpx; line-height:1.7; text-align:center; }.empty { padding-top:160rpx; color:#8d99a7; text-align:center; }
