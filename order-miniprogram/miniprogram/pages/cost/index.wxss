.product { display:flex; gap:20rpx; padding:24rpx; }.image { width:140rpx; height:140rpx; flex:none; background:#f4f6f8; border-radius:14rpx; }.main { min-width:0; flex:1; }.title { display:-webkit-box; overflow:hidden; font-size:28rpx; font-weight:650; line-height:1.5; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.muted { margin-top:14rpx; font-size:22rpx; }.form-card { margin-top:22rpx; padding:30rpx; }.label { font-size:27rpx; font-weight:650; }.cost-input { height:94rpx; margin-top:18rpx; padding:0 24rpx; background:#f5f7fa; border:2rpx solid #dfe7f1; border-radius:14rpx; font-size:36rpx; font-weight:700; }.hint { margin-top:14rpx; color:#8895a3; font-size:22rpx; line-height:1.6; }.note-label { margin-top:32rpx; }.note { box-sizing:border-box; width:100%; height:190rpx; margin-top:18rpx; padding:22rpx; background:#f5f7fa; border-radius:14rpx; font-size:27rpx; }.save { margin-top:32rpx; }.empty { padding-top:180rpx; color:#8b97a4; text-align:center; }
