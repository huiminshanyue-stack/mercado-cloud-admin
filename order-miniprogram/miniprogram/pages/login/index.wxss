.login-page { padding-top: 90rpx; }
.brand { text-align: center; margin-bottom: 60rpx; }
.brand-mark { width: 116rpx; height: 116rpx; margin: 0 auto 22rpx; line-height: 116rpx; border-radius: 32rpx; color:#fff; background:linear-gradient(145deg,#1677ff,#65a7ff); font-size:56rpx; font-weight:700; box-shadow:0 18rpx 42rpx rgba(22,119,255,.28); }
.brand-title { font-size:46rpx; font-weight:700; letter-spacing:4rpx; }
.brand-subtitle { margin-top:12rpx; color:#8a97a6; font-size:26rpx; }
.login-card { padding:38rpx; }
.section-title { font-size:34rpx; font-weight:650; }
.hint { margin:18rpx 0 30rpx; color:#6d7b8a; font-size:26rpx; line-height:1.7; }
.field { height:92rpx; box-sizing:border-box; margin-top:22rpx; padding:0 26rpx; background:#f6f8fb; border:1rpx solid #e4eaf1; border-radius:14rpx; font-size:30rpx; }
.action { margin-top:30rpx; height:92rpx; line-height:92rpx; }
.security { padding:30rpx 18rpx; color:#9aa6b2; font-size:23rpx; line-height:1.6; text-align:center; }
