.home-page { padding-top:34rpx; }.hero { display:flex; justify-content:space-between; align-items:center; padding:20rpx 8rpx 36rpx; }.welcome { font-size:42rpx; font-weight:750; }.subtitle { margin-top:10rpx; color:#7e8a98; font-size:25rpx; }.logout { margin:0; color:#637285; background:#fff; }.overview { display:flex; justify-content:space-around; padding:30rpx 12rpx; text-align:center; }.overview view { display:flex; min-width:0; flex:1; flex-direction:column; border-right:1rpx solid #edf0f4; }.overview view:last-child { border:0; }.number { color:#1677ff; font-size:42rpx; font-weight:750; }.number.warning { color:#e58b00; }.number.danger { color:#ef5350; }.unit { margin-top:7rpx; color:#8995a2; font-size:22rpx; }.section-title { margin:38rpx 4rpx 20rpx; font-size:31rpx; font-weight:700; }.menu-card { display:flex; align-items:center; margin-bottom:20rpx; padding:28rpx 24rpx; color:#1f2d3d; background:#fff; border-radius:20rpx; box-shadow:0 8rpx 28rpx rgba(31,45,61,.05); }.icon { width:82rpx; height:82rpx; margin-right:22rpx; color:#fff; background:#1677ff; border-radius:22rpx; font-size:34rpx; font-weight:700; line-height:82rpx; text-align:center; }.inquiry-menu .icon { background:#f0a020; }.after-menu .icon { background:#ef5960; }.menu-main { min-width:0; flex:1; }.menu-title { font-size:31rpx; font-weight:700; }.menu-desc { margin-top:9rpx; color:#7f8b98; font-size:23rpx; line-height:1.5; }.arrow { margin-left:15rpx; color:#aab3bd; font-size:50rpx; }.badge { min-width:34rpx; height:34rpx; padding:0 8rpx; color:#fff; background:#f0a020; border-radius:20rpx; font-size:20rpx; line-height:34rpx; text-align:center; }.badge.red { background:#ef5960; }.security { padding:30rpx 10rpx; color:#9aa5b1; font-size:22rpx; text-align:center; }
