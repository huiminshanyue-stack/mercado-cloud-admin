.thread-page { min-height:100vh; background:#eef2f7; }.thread-head { padding:20rpx 28rpx; color:#657486; background:#fff; font-size:23rpx; }.messages { box-sizing:border-box; height:48vh; padding:24rpx; }.message-row { display:flex; margin-bottom:22rpx; }.message-row.seller { justify-content:flex-end; }.bubble { max-width:78%; padding:18rpx 20rpx; background:#fff; border-radius:18rpx 18rpx 18rpx 4rpx; box-shadow:0 4rpx 16rpx rgba(31,45,61,.05); }.seller .bubble { color:#fff; background:#1677ff; border-radius:18rpx 18rpx 4rpx 18rpx; }.content { font-size:27rpx; line-height:1.55; word-break:break-all; }.meta { margin-top:10rpx; color:#8a96a3; font-size:20rpx; }.seller .meta { color:rgba(255,255,255,.75); }.composer { padding:22rpx 26rpx 35rpx; background:#fff; }.textarea { box-sizing:border-box; width:100%; height:120rpx; padding:18rpx; background:#f4f6f9; border-radius:12rpx; font-size:26rpx; }.english { margin-top:16rpx; }.translate { margin:14rpx 0 0; color:#1677ff; background:#edf5ff; font-size:25rpx; }.send { margin-top:18rpx; }.empty { padding:100rpx 0; color:#8b97a4; text-align:center; }
