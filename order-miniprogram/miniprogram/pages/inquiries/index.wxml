<view class="page list-page">
  <view class="intro card"><view class="intro-title">{{introTitle}}</view><view class="intro-desc">{{introDesc}}</view></view>
  <view wx:if="{{errors.length}}" class="error-box"><view wx:for="{{errors}}" wx:key="*this">{{item}}</view></view>
  <view wx:if="{{loading && !orders.length}}" class="empty">{{loadingText}}</view>
  <view wx:elif="{{!loading && !orders.length}}" class="empty">{{emptyText}}</view>
  <view wx:for="{{orders}}" wx:key="key" class="card thread" data-id="{{item.orderId}}" bindtap="openThread">
    <view class="head"><text class="country">{{item.countryText}}</text><text class="order-no">{{item.displayOrderId}}</text></view>
    <view class="store">{{item.storeName}} · 买家 {{item.buyer || '-'}}</view>
    <view class="product"><image class="image" mode="aspectFit" src="{{item.productImage}}" /><view class="product-main"><view class="title">{{item.productTitle}}</view><view class="time">{{item.isProductQuestion ? '咨询时间' : '下单'}}：{{item.dateText}}</view></view></view>
    <view class="open">{{channel === 'order_message' ? '打开订单咨询并回复' : '打开商品问题并回复'}} ›</view>
  </view>
</view>
