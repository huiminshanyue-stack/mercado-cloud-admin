.intro { padding:26rpx; }.intro-title { font-size:32rpx; font-weight:700; }.intro-desc { margin-top:10rpx; color:#7e8b99; font-size:23rpx; line-height:1.6; }.thread { margin-top:20rpx; padding:24rpx; }.head { display:flex; justify-content:space-between; }.country { font-weight:650; }.order-no { color:#687789; font-size:24rpx; }.store { margin-top:12rpx; color:#1677ff; font-size:23rpx; }.product { display:flex; gap:18rpx; margin-top:18rpx; padding:18rpx 0; border-top:1rpx solid #edf0f4; }.image { width:110rpx; height:110rpx; flex:none; background:#f4f6f8; border-radius:12rpx; }.product-main { min-width:0; flex:1; }.title { display:-webkit-box; overflow:hidden; font-size:26rpx; font-weight:650; line-height:1.45; -webkit-box-orient:vertical; -webkit-line-clamp:2; }.time { margin-top:10rpx; color:#8995a2; font-size:22rpx; }.open { color:#1677ff; font-size:24rpx; text-align:right; }.empty { padding:150rpx 20rpx; color:#8d99a6; text-align:center; }.error-box { margin-top:18rpx; padding:18rpx; color:#b87400; background:#fff5df; border-radius:12rpx; font-size:22rpx; line-height:1.6; }
