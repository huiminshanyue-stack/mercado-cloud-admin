.intro { padding:26rpx; }.intro-title { font-size:32rpx; font-weight:700; }.intro-desc { margin-top:10rpx; color:#7e8b99; font-size:23rpx; line-height:1.6; }.claim { margin-top:20rpx; padding:24rpx; }.head { display:flex; align-items:center; gap:12rpx; font-size:23rpx; }.status { padding:6rpx 12rpx; color:#ef5350; background:#fff0f0; border-radius:8rpx; }.order { min-width:0; flex:1; overflow:hidden; color:#687789; text-align:right; text-overflow:ellipsis; white-space:nowrap; }.store { margin-top:13rpx; color:#1677ff; font-size:23rpx; }.product { display:flex; gap:18rpx; margin-top:18rpx; padding:18rpx 0; border-top:1rpx solid #edf0f4; }.image { width:110rpx; height:110rpx; flex:none; background:#f4f6f8; border-radius:12rpx; }.product-main { min-width:0; flex:1; }.title { overflow:hidden; font-size:26rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }.reason { margin-top:8rpx; color:#ef5350; font-size:23rpx; }.time { margin-top:8rpx; color:#8995a2; font-size:21rpx; }.open { color:#1677ff; font-size:24rpx; text-align:right; }.empty { padding:150rpx 20rpx; color:#8d99a6; line-height:1.7; text-align:center; }.error-box { margin-top:18rpx; padding:18rpx; color:#b87400; background:#fff5df; border-radius:12rpx; font-size:22rpx; line-height:1.6; }
